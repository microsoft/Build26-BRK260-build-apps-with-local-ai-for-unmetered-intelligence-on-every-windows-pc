<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AIDevGallery.Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#3B2314">

    <Page.Resources>
        <!-- Coffee brown colors -->
        <SolidColorBrush x:Key="TileBackground" Color="#F5E6D3" />
        <SolidColorBrush x:Key="TileBorder" Color="#C4A882" />
        <SolidColorBrush x:Key="CoffeeBrownText" Color="#4A2C17" />
        <SolidColorBrush x:Key="CoffeeBrownSecondary" Color="#6B4226" />
        <SolidColorBrush x:Key="CoffeeBrownTertiary" Color="#8B6914" />
        <SolidColorBrush x:Key="CreamText" Color="#F5E6D3" />

        <Style x:Key="OrderTicketStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TileBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource TileBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MinHeight" Value="200" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="TileTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource CoffeeBrownText}" />
        </Style>

        <Style x:Key="TileSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource CoffeeBrownSecondary}" />
        </Style>

        <Style x:Key="TileDetailStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource CoffeeBrownTertiary}" />
        </Style>
    </Page.Resources>

    <Grid Padding="28" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            Text="☕ Barista Order Queue"
            FontSize="26"
            FontWeight="Bold"
            Foreground="{StaticResource CreamText}" />

        <!-- Order Queue Tickets -->
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            MaxHeight="440">
            <StackPanel x:ConnectionId='5' x:Name="OrderQueuePanel" Spacing="14">
                <!-- Row 1 -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:ConnectionId='11' Grid.Column="0" Style="{StaticResource OrderTicketStyle}"                       >
                        <StackPanel Padding="14" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="Order #73" Style="{StaticResource TileTitleStyle}" />
                            <TextBlock Text="Hey how are you, I don't like coffee that much so can I have a matcha latte with 2 shots of ube flavoring and can I get that large and iced with oat milk. Also can I get 2 cinnamon buns. That's all thanks!" Style="{StaticResource TileDetailStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border x:ConnectionId='12' Grid.Column="1" Style="{StaticResource OrderTicketStyle}"                       >
                        <StackPanel Padding="14" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="Order #74" Style="{StaticResource TileTitleStyle}" />
                            <TextBlock Text="Hi there! Could I get a medium hot chai tea latte with soy milk? Oh and add some vanilla syrup and extra foam on top. Just one please, thank you!" Style="{StaticResource TileDetailStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border x:ConnectionId='13' Grid.Column="2" Style="{StaticResource OrderTicketStyle}"                       >
                        <StackPanel Padding="14" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="Order #75" Style="{StaticResource TileTitleStyle}" />
                            <TextBlock Text="Yo what's up, lemme get uhh a large iced caramel mocha with whole milk, double shot, whipped cream on top and some chocolate drizzle. Actually make that two of those." Style="{StaticResource TileDetailStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border x:ConnectionId='14' Grid.Column="3" Style="{StaticResource OrderTicketStyle}"                       >
                        <StackPanel Padding="14" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="Order #76" Style="{StaticResource TileTitleStyle}" />
                            <TextBlock Text="Hey! Can I get a large mango smoothie with almond milk, add some passion fruit and coconut flakes on top? Oh and a strawberry drizzle too. Just one is fine!" Style="{StaticResource TileDetailStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border x:ConnectionId='15' Grid.Column="4" Style="{StaticResource OrderTicketStyle}"                       >
                        <StackPanel Padding="14" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="Order #77" Style="{StaticResource TileTitleStyle}" />
                            <TextBlock Text="Good morning! I'll have a small hot caramel latte with oat milk please. Can you do salted caramel and brown sugar syrup? And put some cold foam on that. One is good, thanks!" Style="{StaticResource TileDetailStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- Row 2 -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:ConnectionId='6' Grid.Column="0" Style="{StaticResource OrderTicketStyle}"                       >
                        <StackPanel Padding="14" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="Order #78" Style="{StaticResource TileTitleStyle}" />
                            <TextBlock Text="Hi um I'd like a medium iced chai with soy milk, can you add rose water and cardamom? Also a little pistachio on top would be great. Make it decaf please. Just the one!" Style="{StaticResource TileDetailStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border x:ConnectionId='7' Grid.Column="1" Style="{StaticResource OrderTicketStyle}"                       >
                        <StackPanel Padding="14" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="Order #79" Style="{StaticResource TileTitleStyle}" />
                            <TextBlock Text="What's good! Let me get 3 small green tea smoothies with skim milk, throw in some honey and a little ginger. My kids love those. Thanks a bunch!" Style="{StaticResource TileDetailStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border x:ConnectionId='8' Grid.Column="2" Style="{StaticResource OrderTicketStyle}"                       >
                        <StackPanel Padding="14" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="Order #80" Style="{StaticResource TileTitleStyle}" />
                            <TextBlock Text="Hiya, could I please get a medium hot flat white with whole milk? Extra shot of espresso and just a tiny bit of vanilla. One is perfect, thank you so much!" Style="{StaticResource TileDetailStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border x:ConnectionId='9' Grid.Column="3" Style="{StaticResource OrderTicketStyle}"                       >
                        <StackPanel Padding="14" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="Order #81" Style="{StaticResource TileTitleStyle}" />
                            <TextBlock Text="Sup, I'll take a large iced oat milk latte with hazelnut and caramel drizzle, no whip. Oh actually add a pump of mocha too. Make it two please!" Style="{StaticResource TileDetailStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border x:ConnectionId='10' Grid.Column="4" Style="{StaticResource OrderTicketStyle}"                       >
                        <StackPanel Padding="14" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="Order #82" Style="{StaticResource TileTitleStyle}" />
                            <TextBlock Text="Hello! I'm in a rush, can I just get a small hot black coffee? No milk, no sugar, nothing fancy. Actually wait, add a shot of almond syrup. Just one, thanks!" Style="{StaticResource TileDetailStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Recipe Output Area -->
        <Border Grid.Row="2" Background="#2A1810" CornerRadius="12" Padding="20" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:ConnectionId='3'
                        x:Name="RecipeHeader"
                        Text=""
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource CreamText}"
                        VerticalAlignment="Center" />
                    <ProgressRing x:ConnectionId='4'
                        x:Name="RecipeProgressRing"
                        Width="20"
                        Height="20"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <TextBlock x:ConnectionId='2'
                        x:Name="RecipeTextBlock"
                        AutomationProperties.Name="Recipe Output"
                        FontSize="24"
                        Foreground="{StaticResource CreamText}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="WrapWholeWords" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>

